[Unit]
Description=boxci Radicle issue poll (sleek)
After=network.target boxci.service

[Service]
Type=oneshot
User=boxd
Environment=BOXCI_ROOT=/home/boxd/boxci
ExecStart=/usr/bin/curl -fsSL -X POST http://127.0.0.1:8080/api/poll \
  -H 'Content-Type: application/json' \
  -d '{"repo":"rad:z9mjPzpVK472QXaaP1picc5U9xBR","repo_url":"https://nandi.radicle.garden/z9mjPzpVK472QXaaP1picc5U9xBR.git","branch":"main"}'

[Install]
WantedBy=multi-user.target
